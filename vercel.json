{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/staff", "destination": "/staff/index.html" },
    { "source": "/sugerir", "destination": "/sugerir/index.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/staff", "permanent": false }
  ],
  "crons": [
    {
      "path": "/api/cron/reset-diario",
      "schedule": "59 2 * * *"
    }
  ]
}
